<Window x:Class="HexiSure.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HexiSure.WPF"
        mc:Ignorable="d"
        Title="HexiSure" Height="600" Width="900" Background="White">
    <Grid>
        <TabControl>
            <TabItem Header="Home">
                <Viewbox MaxHeight="200">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/images/hexisure.png" Height="100" Width="300" Stretch="Uniform"/>
                            <TextBlock Text="Slim verzekerd, zeker gerust." FontSize="24" FontWeight="Bold" Foreground="#2B2B2B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Beheer uw verzekeringspolissen eenvoudig en professioneel." FontSize="14" Foreground="#555" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </TabItem>

            <TabItem Header="Overzicht Polissen">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Actieve Polissen" FontSize="18" FontWeight="Bold" Foreground="#206088" Margin="0,0,0,10"/>
                    <Button Height="30" Width="30" Margin="5" HorizontalAlignment="Right"
                            Click="RefreshButton_Click"
                            Style="{StaticResource ButtonStyle}"
                            >
                        <Image Source="/images/refresh-button.png" />
                    </Button>
                    <DataGrid Grid.Row="1" Name="PoliciesDataGrid" BorderBrush="#CCC" BorderThickness="2">
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Nieuwe Woningverzekering">
                <ScrollViewer>

                    <Grid>
                        
                        <StackPanel Margin="20">
                            <TextBlock Text="Woninggegevens" FontSize="18" FontWeight="Bold" Foreground="#206088" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Gemeente:" VerticalAlignment="Center" Margin="0,5" Grid.Row="0" Grid.Column="0"/>
                                <ComboBox Name="MunicipalityComboBox" Margin="5" Grid.Row="0" Grid.Column="1"/>
                                <TextBox Name="MunicipalityFilterTextBox" Margin="5" Grid.Row="0" Grid.Column="2" TextChanged="MunicipalityFilterTextBox_TextChanged"/>
                                
                                <TextBlock Text="Adres:" VerticalAlignment="Center" Margin="0,5" Grid.Row="1" Grid.Column="0"/>
                                <TextBox Name="AddressTextBox" Margin="5" Grid.Row="1" Grid.Column="1"/>

                                <TextBlock Text="Type woning:" VerticalAlignment="Center" Margin="0,5" Grid.Row="2" Grid.Column="0"/>
                                <ComboBox Name="TypeComboBox" Margin="5" Grid.Row="2" Grid.Column="1">
                                    <ComboBoxItem Content="Open"/>
                                    <ComboBoxItem Content="Half open"/>
                                    <ComboBoxItem Content="Gesloten"/>
                                    <ComboBoxItem Content="Appartement"/>
                                </ComboBox>

                                <TextBlock Text="Bouwjaar:" VerticalAlignment="Center" Margin="0,5" Grid.Row="3" Grid.Column="0"/>
                                <DatePicker Name="BuildDatePicker" Margin="5" Grid.Row="3" Grid.Column="1"/>

                                <TextBlock Text="Bewoonbare opp. (m²):" VerticalAlignment="Center" Margin="0,5" Grid.Row="4" Grid.Column="0"/>
                                <TextBox Name="LivingAreaTextBox" Margin="5" Grid.Row="4" Grid.Column="1"/>

                                <TextBlock Text="Marktwaarde (€):" VerticalAlignment="Center" Margin="0,5" Grid.Row="5" Grid.Column="0"/>
                                <TextBox Name="MarketValueTextBox" Margin="5" Grid.Row="5" Grid.Column="1"/>


                                <TextBlock Text="Basis Premium:" VerticalAlignment="Center" Margin="0,5" Grid.Row="6" Grid.Column="0"
                                           ToolTip="Dit is de extra kost die je kan toevoegen aan de verzekeringspolis."/>
                                <TextBox Name="BasePremiumTextBox" Margin="5" Grid.Row="6" Grid.Column="1"
                                         ToolTip="Dit is de extra kost die je kan toevoegen aan de verzekeringspolis."/>

                            </Grid>

                            <TextBlock Text="Dekkingen" FontSize="18" FontWeight="Bold" Foreground="#206088" Margin="0 10"/>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                                <CheckBox Margin="5" Content="Voeg brandverzekering toe" Name="AddFireCheckBox"/>
                                <CheckBox Margin="5" Content="Voeg diefstalverzekering (10k) toe" Name="AddTheft10KCheckBox"/>
                                <CheckBox Margin="5" Content="Voeg diefstalverzekering (30k) toe" Name="AddTheft30KCheckBox"/>
                                <CheckBox Margin="5" Content="Voeg rechtsaanspraak toe" Name="AddLegalAidCheckBox"/>
                            </StackPanel>

                            <TextBlock Text="Finaliseren" FontSize="18" FontWeight="Bold" Foreground="#206088" Margin="0,0,0,10"/>

                            <Button Content="Polis aanmaken" Name="CreateHomePolicyButton" Width="200" Margin="5" HorizontalAlignment="Left"
                                    Click="CreateHomePolicyButton_Click"/>
                        </StackPanel>
                        <Button Height="30" Width="30" Margin="5" 
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                Click="ClearButton_Click"
                                Style="{StaticResource ButtonStyle}"
                                >               
                            <Image Source="/images/clear-button.png" />
                        </Button>
                        <Border Style="{StaticResource TagStyle}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Name="TagBorder">
                            <TextBlock Name="TagTextBlock"  Text="✓ New Client Added" Foreground="White" Margin="5 10 5 10"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Nieuwe Autoverzekering">
                <TextBlock Text="Nog toe te voegen ... 🔨" FontSize="18" FontWeight="Bold" Foreground="#206088" Margin="20"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
